# =============================================================================
# VeriSight — Environment Variable Reference
# =============================================================================
# Copy this file to .env for local development.
# On Railway, set these via the Dashboard → Variables tab.
# =============================================================================

# ─── Flask ────────────────────────────────────────────────────────────────────
# Set to "production" on Railway; "development" for local work.
FLASK_ENV=production

# The WSGI entry point — do not change unless you rename wsgi.py.
FLASK_APP=wsgi.py

# A cryptographically random secret key (Flask session signing, CSRF, etc.).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Railway auto-injects DATABASE_URL when you provision a PostgreSQL plugin.
# For local development, use your Neon connection string:
#   DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Separate secret for JWT token signing (different from SECRET_KEY).
JWT_SECRET=change-this-to-a-random-jwt-secret

# Token expiry in hours (default: 24).
JWT_EXPIRATION_HOURS=24

# ─── Upload Limits ────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default: 100 MB = 104857600).
MAX_CONTENT_LENGTH=104857600

# Directory where uploaded videos are stored (relative to project root).
UPLOAD_FOLDER=uploads

# ─── ML Model ─────────────────────────────────────────────────────────────────
# Optional: URL to download fine-tuned Xception weights on first boot.
# If empty, the pretrained ImageNet backbone is used.
MODEL_WEIGHTS_URL=

# Confidence threshold for deepfake classification (0.0 – 1.0; default: 0.5).
MODEL_CONFIDENCE_THRESHOLD=0.5

# Number of frames to skip between analyses (1 = every frame; 30 = every 30th).
FRAME_SAMPLE_RATE=1
