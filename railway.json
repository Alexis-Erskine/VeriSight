{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfig": {
      "phases": {
        "setup": {
          "nixPkgs": ["python3", "gcc", "gfortran", "libjpeg-turbo", "openblas", "cmake", "pkg-config"]
        },
        "install": {
          "cmds": [
            "pip install --upgrade pip setuptools wheel",
            "pip install -r requirements.txt"
          ]
        }
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false,
    "startCommand": "gunicorn wsgi:app --bind 0.0.0.0:$PORT --workers 2 --timeout 300 --worker-class sync --max-requests 1000 --max-requests-jitter 50 --access-logfile - --error-logfile - --log-level info",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30
  }
}
